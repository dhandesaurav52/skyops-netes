rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Artifact objects are only read/written by the Node API with Firebase Admin
    // credentials after server-side organization authorization.  Direct Storage
    // SDK access would otherwise let any signed-in Firebase user read another
    // tenant's predictable object path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
