rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SkyOps uses the server API with Firebase Admin credentials for all
    // application state.  Denying direct client-SDK access prevents a signed-in
    // user from querying another tenant's documents or altering RBAC/billing.
    // Admin SDK calls bypass these rules and enforce membership in server code.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
